{
  "name": "zcode-voice",
  "version": "1.0.0",
  "commands": "./commands",
  "description": "Голосовой ввод ZCode: панель Voice (App plugins). Запись ведёт серверная часть плагина (ffmpeg), панель показывает прогресс и редактируемый текст; повторные записи дописываются. Офлайн-распознавание GigaAM v3.",
  "author": {
    "name": "wmachine"
  },
  "mcpServers": {
    "voice": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${ZCODE_PLUGIN_ROOT}/dist/server.mjs"
      ]
    }
  },
  "ui": {
    "surfaces": [
      {
        "id": "voice",
        "title": {
          "en-US": "Voice",
          "ru-RU": "Голосовой ввод",
          "zh-CN": "语音输入"
        },
        "icon": "mic",
        "server": "voice",
        "resourceUri": "ui://voice/panel.html",
        "availability": "session"
      }
    ]
  }
}
